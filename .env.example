RUNSCOPE_ENVIRONMENT=development
RUNSCOPE_DATABASE_URL=postgresql+asyncpg://runscope:runscope-local@postgres:5432/runscope
RUNSCOPE_REDIS_URL=redis://redis:6379/0
RUNSCOPE_BROKER_BOOTSTRAP_SERVERS=redpanda:9092
RUNSCOPE_OUTBOX_MAX_ATTEMPTS=10
RUNSCOPE_S3_ENDPOINT_URL=http://minio:9000
RUNSCOPE_S3_ACCESS_KEY=runscope-local
RUNSCOPE_S3_SECRET_KEY=change-me-for-any-shared-environment
RUNSCOPE_S3_BUCKET=runscope-artifacts
RUNSCOPE_ARTIFACT_BACKEND=s3
RUNSCOPE_STORAGE_MAX_ATTEMPTS=3
RUNSCOPE_STORAGE_RETRY_BASE_SECONDS=0.1
RUNSCOPE_JWT_SECRET=change-me-local-development-only-at-least-32-bytes
RUNSCOPE_ACCESS_TOKEN_MINUTES=30
RUNSCOPE_SCHEDULER_POLL_SECONDS=0.5
RUNSCOPE_ALLOCATION_LEASE_SECONDS=30
RUNSCOPE_WORKER_STALE_SECONDS=15
RUNSCOPE_WORKER_NAME=worker-local-1
RUNSCOPE_WORKER_TOTAL_CPU=4
RUNSCOPE_WORKER_TOTAL_MEMORY_MB=8192
RUNSCOPE_WORKER_HEARTBEAT_SECONDS=3
RUNSCOPE_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:8000/api/v1
